<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:tools1="http://schemas.android.com/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    xmlns:tools3="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_graph_logs">

    <navigation android:id="@+id/nav_graph_logs"
        app:startDestination="@id/nav_logs">

        <fragment
            android:id="@+id/nav_logs"
            android:name="de.coderchris97.simpleshootbook.ui.logs.LogsFragment"
            android:label="@string/fragment_name_logs"
            tools:layout="@layout/fragment_log" />
    </navigation>

    <navigation android:id="@+id/nav_graph_weapons"
        app:startDestination="@id/nav_weapons">

        <fragment
            android:id="@+id/nav_weapons"
            android:name="de.coderchris97.simpleshootbook.ui.weapons.WeaponsFragment"
            android:label="@string/fragment_name_weapons"
            tools1:layout="@layout/fragment_weapons" >

            <action
                android:id="@+id/navigate_overview_to_details"
                app:destination="@id/nav_weapon_details" />

            <action
                android:id="@+id/navigate_overview_to_edit"
                app:destination="@id/nav_weapon_edit" />

        </fragment>

        <fragment
            android:id="@+id/nav_weapon_details"
            android:name="de.coderchris97.simpleshootbook.ui.weapons.WeaponDetailsFragment"
            android:label="@string/fragment_name_weapon_details"
            tools:layout="@layout/fragment_weapon_details" >

            <argument
                android:name="weaponId"
                app:argType="long" />

            <action
                android:id="@+id/navigate_details_to_edit"
                app:destination="@id/nav_weapon_edit"/>

        </fragment>

        <fragment
            android:id="@+id/nav_weapon_edit"
            android:name="de.coderchris97.simpleshootbook.ui.weapons.WeaponEditFragment"
            android:label="@string/fragment_name_weapon_edit"
            tools:layout="@layout/fragment_weapon_edit" >

            <argument
                android:name="weaponId"
                app:argType="long"
                android:defaultValue="-1L" />

        </fragment>

    </navigation>

    <navigation android:id="@+id/nav_graph_ranges"
        app:startDestination="@id/nav_ranges">

        <fragment
            android:id="@+id/nav_ranges"
            android:name="de.coderchris97.simpleshootbook.ui.ranges.RangesFragment"
            android:label="@string/fragment_name_ranges"
            tools2:layout="@layout/fragment_ranges" >

            <action
                android:id="@+id/navigate_overview_to_details"
                app:destination="@id/nav_range_details" />

            <action
                android:id="@+id/navigate_overview_to_edit"
                app:destination="@id/nav_range_edit" />

        </fragment>

        <fragment
            android:id="@+id/nav_range_details"
            android:name="de.coderchris97.simpleshootbook.ui.ranges.RangeDetailsFragment"
            android:label="@string/fragment_name_range_details"
            tools:layout="@layout/fragment_range_details">

            <argument
                android:name="rangeId"
                app:argType="long" />

            <action
                android:id="@+id/navigate_details_to_edit"
                app:destination="@id/nav_range_edit" />
        </fragment>

        <fragment
            android:id="@+id/nav_range_edit"
            android:name="de.coderchris97.simpleshootbook.ui.ranges.RangeEditFragment"
            android:label="@string/fragment_name_range_edit"
            tools:layout="@layout/fragment_range_edit" >

            <argument
                android:name="rangeId"
                app:argType="long"
                android:defaultValue="-1L" />

        </fragment>
    </navigation>

    <fragment
        android:id="@+id/nav_about"
        android:name="de.coderchris97.simpleshootbook.ui.AboutFragment"
        android:label="@string/fragment_name_about"
        tools3:layout="@layout/fragment_about"/>
</navigation>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="1dp"
    android:layout_margin="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <TextView
            android:id="@+id/display_name_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/arrow_image_view"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Manufacturer and Model" />

        <ImageView
            android:id="@+id/arrow_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right_24"
            app:tint="@color/black"/>

        <TextView
            android:id="@+id/serial_number_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/display_name_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/weapon_type_text_view"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Serial Number"/>

        <TextView
            android:id="@+id/weapon_type_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/display_name_text_view"
            app:layout_constraintStart_toEndOf="@id/serial_number_text_view"
            app:layout_constraintEnd_toStartOf="@id/calibre_text_view"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Weapon Type"/>

        <TextView
            android:id="@+id/calibre_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/display_name_text_view"
            app:layout_constraintStart_toEndOf="@id/weapon_type_text_view"
            app:layout_constraintEnd_toStartOf="@id/arrow_image_view"
            android:layout_marginEnd="10dp"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Calibre"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
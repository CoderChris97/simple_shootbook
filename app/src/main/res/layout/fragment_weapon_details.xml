<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title"
        android:maxLines="1"
        android:ellipsize="end"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:stretchColumns="0,1">

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/manufacturer_label"/>

                <TextView
                    android:id="@+id/manufacturer_text_view"
                    tools:text="Manufacturer"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/model_label"/>

                <TextView
                    android:id="@+id/model_text_view"
                    tools:text="Model"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/serial_number_label"/>

                <TextView
                    android:id="@+id/serial_number_text_view"
                    tools:text="SerialNumber"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/weapon_type_label"/>

                <TextView
                    android:id="@+id/weapon_type_text_view"
                    tools:text="WeaponType"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/calibre_label"/>

                <TextView
                    android:id="@+id/calibre_text_view"
                    tools:text="Calibre"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/purchase_date_label"/>

                <TextView
                    android:id="@+id/purchase_date_text_view"
                    tools:text="PurchaseDate"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_span="2"
                    android:text="@string/comment_label"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:id="@+id/comment_text_view"
                    android:layout_span="2"
                    tools:text="@tools:sample/lorem/random" />

            </TableRow>

        </TableLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

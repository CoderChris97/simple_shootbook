<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title"
        android:maxLines="1"
        android:ellipsize="end"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:stretchColumns="0,1">

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/street_label"/>

                <TextView
                    android:id="@+id/street_text_view"
                    tools:text="Musterstraße"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/housenumber_label"/>

                <TextView
                    android:id="@+id/housenumber_text_view"
                    tools:text="1"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/postal_code_label"/>

                <TextView
                    android:id="@+id/postal_code_text_view"
                    tools:text="123456"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/city_label"/>

                <TextView
                    android:id="@+id/city_text_view"
                    tools:text="Musterstadt"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_span="2"
                    android:text="@string/comment_label"/>

            </TableRow>

            <TableRow>

                <TextView
                    android:id="@+id/comment_text_view"
                    android:layout_span="2"
                    tools:text="@tools:sample/lorem/random" />

            </TableRow>

        </TableLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
